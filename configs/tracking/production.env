# Non-secret W&B identity for pilot/production runs (the API key stays in ~/.netrc).
# Source of truth for docs/EXPERIMENT_PROTOCOL.md and the experiment-launch skill:
# every orchestrated job must carry these in jobs[].env, because a detached or
# headless launch inherits nothing from an interactive shell.
WANDB_ENTITY=shunsuke-n-waseda-university
WANDB_PROJECT=single-teacher-ard
# Group variables are per campaign/teacher (e.g. WANDB_GROUP_CHEN=chen-cifar10-r18);
# the launch skill sets them from the plan, not from this file.
