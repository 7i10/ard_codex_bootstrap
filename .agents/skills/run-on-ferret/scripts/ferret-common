#!/usr/bin/env bash
set -Eeuo pipefail
: "${FERRET_HOST:=Ferret}"
# The system Python is intentionally not used for experiments: on Ferret it
# does not provide the pinned Torch/CUDA stack.  Callers may still override
# this for a validated environment.
FERRET_SKILL_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
FERRET_WORKSPACE_REGISTRY="${ARD_WORKSPACE_REGISTRY:-$FERRET_SKILL_REPO_ROOT/configs/workspace/ard_workspace_v1.json}"
workspace_value() {
  python3 "$FERRET_SKILL_REPO_ROOT/scripts/workspace_paths.py" --registry "$FERRET_WORKSPACE_REGISTRY" "$1"
}
: "${FERRET_PYTHON:=$(workspace_value python)}"
: "${FERRET_REPO_ROOT:=$(workspace_value repo_root)}"
: "${FERRET_EXPECTED_REMOTE:=https://github.com/7i10/ard_codex_bootstrap.git}"
: "${FERRET_RUN_ROOT:=$(workspace_value run_root)}"
: "${HAMSTER_RESULT_ROOT:=$(workspace_value staging_root)/ferret-results}"
: "${FERRET_MAX_GPUS:=3}"
: "${FERRET_PREPARE_LOCK:=$(workspace_value lock_root)/ferret-prepare.lock}"
FERRET_SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10 "$FERRET_HOST")
[[ $FERRET_REPO_ROOT == /* && $FERRET_RUN_ROOT == /* && $FERRET_RUN_ROOT != / && $HAMSTER_RESULT_ROOT == /* && $HAMSTER_RESULT_ROOT != / ]] || { echo 'error: configured roots must be safe absolute paths' >&2; exit 2; }
[[ $FERRET_PYTHON == /* && $FERRET_PYTHON != *[[:space:]]* ]] || { echo 'error: FERRET_PYTHON must be an absolute executable path' >&2; exit 2; }
[[ $FERRET_PREPARE_LOCK == /* && $FERRET_PREPARE_LOCK != / && $FERRET_PREPARE_LOCK != *[[:space:]]* ]] || { echo 'error: FERRET_PREPARE_LOCK must be a safe absolute path' >&2; exit 2; }
[[ $FERRET_MAX_GPUS =~ ^[1-9][0-9]*$ ]] || { echo 'error: FERRET_MAX_GPUS must be a positive integer' >&2; exit 2; }

die() { printf 'error: %s\n' "$*" >&2; exit 2; }
valid_run_id() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ && "$1" != *..* ]] || die 'invalid run-id'; }
valid_sha() { [[ "$1" =~ ^[0-9a-fA-F]{40}$ ]] || die 'SHA must be exactly 40 hex characters'; }
run_dir() { valid_run_id "$1"; printf '%s/%s\n' "${FERRET_RUN_ROOT%/}" "$1"; }
q() { printf '%q' "$1"; }
